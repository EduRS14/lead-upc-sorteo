# Copia este archivo como .env.local y completa los valores reales.
# En Vercel, define estas mismas variables en Settings → Environment Variables.

VITE_SHEET_URL=https://script.google.com/macros/s/XXXX/exec
VITE_SHEET_TOKEN=tu-token

# Opcional: fuerza los datos de prueba incluso si la URL está configurada.
# Útil para ensayar el build sin tocar la hoja real.
VITE_USE_MOCK=false
